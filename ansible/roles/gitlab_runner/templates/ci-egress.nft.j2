# {{ ansible_managed }}
# Own table, never the stock nftables.conf: that file begins by flushing the whole ruleset,
# which would wipe the rules Docker installed. Declare-then-delete makes reloads idempotent.
table inet ci_egress
delete table inet ci_egress

table inet ci_egress {
    chain output {
        type filter hook output priority 0; policy accept;
        oif lo accept
        meta nfproto ipv6 drop
        ct state established,related accept
        ip daddr {{ gitlab_runner_lan_gateway }} meta l4proto { udp, tcp } th dport 53 accept
        ip daddr {{ gitlab_runner_lan_cidr }} drop
    }
    chain forward {
        type filter hook forward priority 0; policy accept;
        meta nfproto ipv6 drop
        ct state established,related accept
        ip daddr {{ gitlab_runner_lan_gateway }} meta l4proto { udp, tcp } th dport 53 accept
        ip daddr {{ gitlab_runner_lan_cidr }} drop
    }
    chain input {
        type filter hook input priority 0; policy accept;
        iif lo accept
        tcp dport { 9100, {{ gitlab_runner_listen_port }} } ip saddr != { {{ gitlab_runner_metrics_allowed_from | join(', ') }} } drop
    }
}
