# {{ ansible_managed }}
# Prometheus alert rules for the Plex blip (plex-blip-manual-triage Step 7a),
# design §5.3 verbatim. THE FIRST RULE FILE THIS STACK HAS EVER HAD: `rule_files`
# was zero hits across ansible/ before this render, so Prometheus has been
# evaluating nothing since it was provisioned and every detection in this
# objective has depended on a human noticing a paused stream.
#
# ALERTMANAGER IS DEFERRED BY OPERATOR DECISION. There is no `alerting:` block in
# prometheus.yml.j2 and no receiver anywhere, so these rules evaluate and appear
# in Prometheus -> Alerts and in Grafana's alert list, and NOTHING IS PUSHED. An
# operator has to look. The runbook says so rather than implying a notification
# path exists.
#
# HOW THIS FILE REACHES THE PROCESS, measured on the pinned prom/prometheus:v3.12.0
# (logs/builder-7a-handler-question.log) rather than assumed from the four renders
# that already carry a handler:
#
#   POST /-/reload                     403 "Lifecycle API is not enabled." — the
#                                      compose command: passes no --web.enable-lifecycle
#   edit IN PLACE, same inode, +40s    the container SEES the new bytes and the
#                                      process serves the OLD rule set
#   ATOMIC REPLACE, new inode, +40s    the container cannot even SEE the new bytes:
#                                      a single-FILE bind holds the old inode, and
#                                      os.replace is what ansible.builtin.template does
#   docker compose restart prometheus  same container id, new inode visible, new
#                                      rule set served
#
# So `notify: Restart prometheus` on the render task is the whole delivery path,
# and it is required for TWO reasons where the neighbouring renders each have one.
#
# THE PATH IS NAMED ONCE. prometheus.yml.j2's `rule_files:` carries the
# container-side path as a LITERAL and not a glob, because a glob matching zero
# files is `promtool check config` rc=0 with the "N rule files found" line simply
# absent while a missing literal is rc=1 (logs/builder-7a-literal-vs-glob.log,
# each direction with its own control). The loudness is promtool's and not the
# running process's — a literal naming a missing file starts clean and serves
# `{"groups":[]}` — which is why Step 7c runs the validator before the handler.
#
# NO `labels:` AND NO `annotations:` HERE. Design §5.3 carries neither; plan.md's
# "every alert has severity and a summary annotation" is an obligation on Step 7d,
# which owns them together with the `promtool test rules` unit test. Adding them
# here would be this step writing 7d's row.
#
# EVERY ONE OF THE SEVEN COMPARES A SERIES TO A CONSTANT AND SO CANNOT MATCH AN
# ABSENT ONE. `plex_watchdog_probe_status == 0` returns an EMPTY vector exactly when
# the watchdog has stopped producing — the one moment the meta-guard exists for —
# while `absent(plex_watchdog_probe_status)` returns 1. Measured at the Step 5 ->
# Step 7 wave cut with a positive control (logs/planner-step07-live.log) and
# re-driven on THIS file at Step 7b (logs/builder-7b-absence-doors.log). The three
# `absent()` doors at the bottom of this group are that row; they are one per
# PRODUCER and not one per rule, because the absences are shared.
groups:
  - name: plex-blip
    rules:
      # Catches what probe_success misses (design R10): on 2026-08-07 /identity
      # answered HTTP 200 through the entire five-minute outage, so a success
      # check on the cheap endpoint alone stays green throughout the fault this
      # whole objective exists for (research/live-blip-2026-08-07-case-study.md).
      - alert: PlexProbeSlow
        expr: probe_duration_seconds{job="blackbox-plex-identity"} > 0.5
        for: 1m
      # The other half of the differential: /identity fast + /status/sessions slow
      # is the database/lock signature, both slow is host or thread-pool
      # saturation. The same run reached 101,394 ms on this endpoint.
      - alert: PlexSessionsProbeStalled
        expr: probe_duration_seconds{job="blackbox-plex-sessions"} > 5
        for: 1m
      # The regex fans in to all three blackbox-plex jobs, which is a relation
      # prometheus.yml.j2's own 5c comment deferred to this step in writing. The
      # guard now holds it as an exact set rather than a shared prefix.
      - alert: PlexUnreachable
        expr: probe_success{job=~"blackbox-plex.*"} == 0
        for: 30s
      # EXPLICITLY NOT "PLEX IS DOWN" (design R5). This fires when the metrics
      # EXPORTER stops answering, which the current single-panel dashboard invites
      # an operator to read as the server being down; those are different faults
      # with different first moves, and conflating them is what this alert's name
      # is chosen to prevent.
      - alert: PlexExporterScrapeFailing
        expr: up{job="plex-exporter"} == 0
        for: 2m
      # The leading indicator (design R12): the WAL grows before the stalls start,
      # so this is the only rule here that can fire BEFORE a user notices. 8 MiB,
      # against the 41.71 MiB observed during the live blip.
      - alert: PlexSqliteWalOversized
        expr: plex_sqlite_wal_bytes > 8388608
        for: 15m
      # No `for:` and that is the design's: increase(...[5m]) already carries its
      # own window, so a second one would only delay the same claim.
      - alert: PlexTransactionHoldStorm
        expr: increase(plex_watchdog_events_total{event_type="TX_HELD"}[5m]) > 3
      # THE META-GUARD (design P5). The whole reason this project exists in its
      # current shape is that a diagnostic tool failed silently for days — `fuser`
      # was missing from CT 110 and 34 consecutive probes recorded nothing. The
      # monitoring must monitor itself. See the note above: this rule cannot match
      # an absent series, and PlexWatchdogTextfileAbsent below is its door.
      - alert: PlexWatchdogProbeBroken
        expr: plex_watchdog_probe_status == 0
        for: 10m
      # --- Step 7b: the absence doors ---------------------------------------
      # ONE DOOR PER PRODUCER. The three blackbox jobs vanish together with the
      # blackbox exporter, `up{job="plex-exporter"}` vanishes only with its scrape
      # config, and the watchdog's families vanish together with its .prom — so
      # three doors cover all seven rules above without any of them firing twice
      # on one event.
      #
      # EACH JOB IS NAMED SEPARATELY AND THAT IS THE POINT, not verbosity:
      # `absent()` returns a sample only when its selector matches NOTHING, so a
      # single `absent(probe_success{job=~"blackbox-plex.*"})` stays EMPTY while
      # any one of the three is still reporting — silent with two probes gone,
      # which is this row's own defect one step in. Measured with its control
      # (logs/builder-7b-absence-doors.log).
      #
      # `for: 5m` outlasts four missed scrapes of the slowest job that feeds this
      # door (blackbox-plex-sessions at 60s); a stale marker from one restarted
      # exporter must not page, because a door that cries wolf is retired and the
      # rules above go back to being silent.
      - alert: PlexBlackboxProbesAbsent
        expr: >-
          absent(probe_success{job="blackbox-plex-identity"}) or
          absent(probe_success{job="blackbox-plex-sessions"}) or
          absent(probe_success{job="blackbox-plex-proxied"})
        for: 5m
      # NOT the same fault as PlexExporterScrapeFailing and the pair is the whole
      # reason both exist: Prometheus SYNTHESISES `up` for a configured target
      # whether the scrape succeeds or not, so `up == 0` covers the exporter being
      # down and cannot see the job being deleted from prometheus.yml. This one is
      # config drift — the target nobody is watching because nobody asked for it.
      - alert: PlexExporterTargetAbsent
        expr: absent(up{job="plex-exporter"})
        for: 5m
      # THE DOOR IS OVER plex_sqlite_db_bytes AND THAT IS A MEASUREMENT, not a
      # preference. render_textfile_metrics OMITS a family whose measurement is
      # null rather than publishing a zero, and only the trigger branch populates
      # the probe/event families while the sqlite gauges go out on the idle poll
      # every textfile_refresh_sec (15.0s). Driven on the real CLI both ways
      # (logs/builder-7b-absence-doors.log W1/W2): a never-triggered watchdog with
      # the WAL checkpointed serves 130 BYTES — plex_sqlite_db_bytes ALONE — and
      # the same watchdog with a live writer serves wal+db+shm.
      #
      # So absent(plex_watchdog_probe_status) would page on every healthy stack
      # that has not blipped, and absent(plex_sqlite_wal_bytes) would page on
      # every checkpointed database — that second one was this rule's first draft
      # and the CLI run above is what refused it. db_bytes is the family that is
      # there whenever the document is, so its absence IS the document's:
      # watchdog dead, --textfile-dir unset, or the .prom unreadable to
      # node-exporter's uid (a UMask=0077 in the unit -> 0600 root:root -> EACCES
      # -> every family absent). This door makes that outage VISIBLE; nothing yet
      # PREVENTS it, and the mode is pinned by nothing at task-1786230668-0902.
      #
      # WHAT THIS DOOR STILL CANNOT SEE is a watchdog RESTART: the restarted
      # process republishes the sqlite gauges immediately, so "restarted" and
      # "healthy, never blipped" are the same document. That needs an unconditional
      # liveness series from the watchdog — watchdog surface, not rule surface —
      # and stays open at task-1786230651-63ba. The two rows this file inherited
      # the argument from (task-1786159639-39db, task-1786167833-1152) are CLOSED
      # by this step; those two ids are their live successors.
      - alert: PlexWatchdogTextfileAbsent
        expr: absent(plex_sqlite_db_bytes)
        for: 10m
