---
# {{ ansible_managed }}
# Traefik reverse proxy + whoami smoke service (design §4.4).
# whoami is exposed ONLY through Traefik labels (no published host port) and is
# internal-only via the internal-allowlist middleware.
services:
  traefik:
    image: {{ docker_host_traefik_image }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      # No insecure dashboard publish: the API/dashboard is served only via the
      # routed api@internal service behind the traefik-dashboard router (dynamic.yml.j2).
    # CF_DNS_API_TOKEN is read from the sibling .env (rendered from vault), used
    # by the le-dns-cf Cloudflare DNS-01 resolver. Never embedded in this file.
    environment:
      - CF_DNS_API_TOKEN=${CF_DNS_API_TOKEN:-}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ docker_host_project_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro
      - {{ docker_host_project_dir }}/dynamic:/etc/traefik/dynamic:ro
      - {{ docker_host_project_dir }}/acme.json:/acme.json

  # --- Cloudflare Tunnel connector (Step 4, design §4/§A). ---
  # Outbound-only connector to a remotely-managed tunnel: NO published ports, so
  # there is zero inbound surface and no dashboard is ever reachable before the
  # Step-5 Cloudflare Access gate exists. TUNNEL_TOKEN is read from the sibling
  # .env (rendered from vault_cloudflare_tunnel_token), never a literal. Each
  # dashboard-managed public hostname points its Service URL at http://traefik:80
  # (plain HTTP over the internal compose network — TLS is terminated at the
  # Cloudflare edge, so there is no SNI/cert to match and no origin-side TLS
  # config the simplified UI can't express). Traefik serves it via the per-host
  # <svc>-web routers below. cloudflared's source is in the 172.16.0.0/12 range
  # already admitted by the internal-allowlist middleware.
  cloudflared:
    image: {{ docker_host_cloudflared_image }}
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    environment:
      - TUNNEL_TOKEN=${TUNNEL_TOKEN:-}
    depends_on:
      - traefik

  whoami:
    image: {{ docker_host_whoami_image }}
    restart: unless-stopped
    # Internal-only smoke route: discovered by the docker provider, routed on
    # websecure, TLS via the active resolver, gated by internal-allowlist.
    labels:
      - traefik.enable=true
      - traefik.http.routers.whoami.rule=Host(`whoami.{{ domain }}`)
      - traefik.http.routers.whoami.entrypoints=websecure
      - traefik.http.routers.whoami.tls=true
      - traefik.http.routers.whoami.tls.certresolver={{ acme_resolver }}
      # The DNS-01 wildcard tls.domains request was relocated (Step 3) onto the stable
      # traefik-dashboard file-provider router (dynamic.yml.j2), so proactive wildcard
      # issuance no longer depends on this docker service. Traefik's global cert store
      # then serves that one wildcard for whoami and every other matching host.
      - traefik.http.routers.whoami.middlewares=internal-allowlist@file,security-headers@file
      # Plain-HTTP twin router for the Cloudflare tunnel (cloudflared -> http://traefik:80;
      # edge-terminated TLS). No `tls` -> served directly; our security-headers sets no
      # sslRedirect so there is no redirect loop. It keeps internal-allowlist, so a WAN
      # request arriving via the plex :80 port-forward with this Host is still 403'd. The
      # websecure router above still serves LAN/Tailscale direct with the real LE cert.
      - traefik.http.routers.whoami-web.rule=Host(`whoami.{{ domain }}`)
      - traefik.http.routers.whoami-web.entrypoints=web
      - traefik.http.routers.whoami-web.service=whoami
      - traefik.http.routers.whoami-web.middlewares=internal-allowlist@file,security-headers@file
      - traefik.http.services.whoami.loadbalancer.server.port=80

  # --- Extras stack (Step 10): LAN/Tailscale-only dashboards & monitoring. ---
  # Each is routed by the docker provider (labels only, no published host port),
  # on websecure with the var-driven {{ acme_resolver }} resolver, and carries
  # internal-allowlist@file + security-headers@file so it is reachable on the LAN/
  # Tailscale and blocked from the WAN. None appear in public_services.
  homepage:
    image: {{ docker_host_homepage_image }}
    restart: unless-stopped
    # gethomepage/homepage (v0.9.0+) validates the Host header: any request whose
    # Host is not localhost or in HOMEPAGE_ALLOWED_HOSTS gets a "Host validation
    # failed" page. Reached only via Traefik on home.{{ domain }}, so that
    # host MUST be allow-listed or the dashboard never loads.
    environment:
      - HOMEPAGE_ALLOWED_HOSTS=home.{{ domain }}
    volumes:
      # Homepage v1.x self-initializes skeleton configs (bookmarks/docker/
      # kubernetes/…) AND writes logs into /app/config on startup, so the dir
      # MUST be writable — a read-only mount fails with EROFS/ENOENT before the
      # UI ever loads. The ansible-managed files (settings/services/widgets) are
      # re-rendered every play so they stay authoritative; homepage only adds the
      # missing skeletons + logs/ alongside them, all visible on the host under
      # {{ docker_host_project_dir }}/homepage.
      - {{ docker_host_project_dir }}/homepage:/app/config
    labels:
      - traefik.enable=true
      - traefik.http.routers.homepage.rule=Host(`home.{{ domain }}`)
      - traefik.http.routers.homepage.entrypoints=websecure
      - traefik.http.routers.homepage.tls=true
      - traefik.http.routers.homepage.tls.certresolver={{ acme_resolver }}
      - traefik.http.routers.homepage.middlewares=internal-allowlist@file,security-headers@file
      # Plain-HTTP twin for the tunnel (see whoami-web).
      - traefik.http.routers.homepage-web.rule=Host(`home.{{ domain }}`)
      - traefik.http.routers.homepage-web.entrypoints=web
      - traefik.http.routers.homepage-web.service=homepage
      - traefik.http.routers.homepage-web.middlewares=internal-allowlist@file,security-headers@file
      - traefik.http.services.homepage.loadbalancer.server.port=3000

  uptime-kuma:
    image: {{ docker_host_uptime_kuma_image }}
    restart: unless-stopped
    volumes:
      - uptime-kuma-data:/app/data
    labels:
      - traefik.enable=true
      - traefik.http.routers.uptime-kuma.rule=Host(`uptime.{{ domain }}`)
      - traefik.http.routers.uptime-kuma.entrypoints=websecure
      - traefik.http.routers.uptime-kuma.tls=true
      - traefik.http.routers.uptime-kuma.tls.certresolver={{ acme_resolver }}
      - traefik.http.routers.uptime-kuma.middlewares=internal-allowlist@file,security-headers@file
      # Plain-HTTP twin for the tunnel (see whoami-web).
      - traefik.http.routers.uptime-kuma-web.rule=Host(`uptime.{{ domain }}`)
      - traefik.http.routers.uptime-kuma-web.entrypoints=web
      - traefik.http.routers.uptime-kuma-web.service=uptime-kuma
      - traefik.http.routers.uptime-kuma-web.middlewares=internal-allowlist@file,security-headers@file
      - traefik.http.services.uptime-kuma.loadbalancer.server.port=3001

  grafana:
    image: {{ docker_host_grafana_image }}
    restart: unless-stopped
    # Admin password is sourced from the sibling .env (rendered from vault),
    # never embedded here. GF_SECURITY_ADMIN_PASSWORD comes from env.j2.
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GF_SECURITY_ADMIN_PASSWORD:-}
    volumes:
      - grafana-data:/var/lib/grafana
      - {{ docker_host_project_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ docker_host_project_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana.rule=Host(`grafana.{{ domain }}`)
      - traefik.http.routers.grafana.entrypoints=websecure
      - traefik.http.routers.grafana.tls=true
      - traefik.http.routers.grafana.tls.certresolver={{ acme_resolver }}
      - traefik.http.routers.grafana.middlewares=internal-allowlist@file,security-headers@file
      # Plain-HTTP twin for the tunnel (see whoami-web).
      - traefik.http.routers.grafana-web.rule=Host(`grafana.{{ domain }}`)
      - traefik.http.routers.grafana-web.entrypoints=web
      - traefik.http.routers.grafana-web.service=grafana
      - traefik.http.routers.grafana-web.middlewares=internal-allowlist@file,security-headers@file
      - traefik.http.services.grafana.loadbalancer.server.port=3000

  prometheus:
    image: {{ docker_host_prometheus_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
    volumes:
      - {{ docker_host_project_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    labels:
      - traefik.enable=true
      - traefik.http.routers.prometheus.rule=Host(`prometheus.{{ domain }}`)
      - traefik.http.routers.prometheus.entrypoints=websecure
      - traefik.http.routers.prometheus.tls=true
      - traefik.http.routers.prometheus.tls.certresolver={{ acme_resolver }}
      - traefik.http.routers.prometheus.middlewares=internal-allowlist@file,security-headers@file
      # Plain-HTTP twin for the tunnel (see whoami-web).
      - traefik.http.routers.prometheus-web.rule=Host(`prometheus.{{ domain }}`)
      - traefik.http.routers.prometheus-web.entrypoints=web
      - traefik.http.routers.prometheus-web.service=prometheus
      - traefik.http.routers.prometheus-web.middlewares=internal-allowlist@file,security-headers@file
      - traefik.http.services.prometheus.loadbalancer.server.port=9090

  # Scrape targets only: NO Traefik labels, NO router — Prometheus reaches them
  # over the internal compose network; they are never routed or exposed.
  node-exporter:
    image: {{ docker_host_node_exporter_image }}
    restart: unless-stopped
    command:
      - --path.rootfs=/host
    pid: host
    volumes:
      - /:/host:ro,rslave

  cadvisor:
    image: {{ docker_host_cadvisor_image }}
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro

  # Proxmox VE exporter (plex-monitoring Step 2): host + per-guest CPU/memory/
  # disk/network for the PVE node and every LXC, including the Plex CT 110.
  # Scrape-only like the two above — Prometheus reaches it at pve-exporter:9221
  # over the internal compose network. It talks OUT to the PVE API at
  # {{ docker_host_pve_api_host }}:8006; it is a MULTI-TARGET exporter, so the
  # scrape job must ask for /pve?target=<pve host> (prometheus.yml.j2) — the
  # default /metrics path serves only this container's own process metrics.
  pve-exporter:
    image: {{ docker_host_pve_exporter_image }}
    restart: unless-stopped
    # Env-var configuration activates ONLY when PVE_USER is set; the exporter
    # then reads PVE_TOKEN_NAME/PVE_TOKEN_VALUE/PVE_VERIFY_SSL. Without PVE_USER
    # it ignores all three and falls back to an on-disk /etc/prometheus/pve.yml
    # which this image does not ship — measured on 3.9.0, cli.py:110 opens that
    # path unguarded, so the process dies at STARTUP with FileNotFoundError and
    # `restart: unless-stopped` makes it a crash loop. It does NOT stay up and
    # serve 401s; there is no scrape at all (logs/calibration-step02a-f3.log, A).
    # PVE_TOKEN_VALUE is read from the
    # sibling .env (rendered from vault_pve_api_token), never a literal here.
    # PVE_VERIFY_SSL=false is required, not cosmetic: the PVE certificate is
    # self-signed (mise.toml PROXMOX_VE_INSECURE=true), so verification on would
    # error every scrape at the TLS handshake.
    environment:
      - PVE_USER={{ docker_host_pve_user }}
      - PVE_TOKEN_NAME={{ docker_host_pve_token_name }}
      - PVE_TOKEN_VALUE=${PVE_TOKEN_VALUE:-}
      - PVE_VERIFY_SSL=false
    # --no-collector.config drops one PVE API call per guest; the config
    # collector's metrics are not used by any dashboard here.
    command:
      - --no-collector.config

  # Plex Media Server exporter (plex-monitoring Step 3): library sizes, stream
  # counts and transcode counts for the Plex server in CT 110. Scrape-only like
  # the three above — Prometheus reaches it at plex-exporter:9594 over the
  # internal compose network. It talks OUT to Plex at {{ docker_host_plex_url }},
  # the same cross-LXC path Traefik's file provider already uses.
  #
  # UNLIKE pve-exporter this is NOT a multi-target exporter: config.ru mounts
  # Prometheus::Middleware::Exporter and the collector runs only when PATH_INFO
  # is exactly "/metrics", so the scrape job is an ordinary single-target one
  # with no metrics_path (prometheus.yml.j2). Copying the /pve shape here is a
  # 404, not a no-op.
  plex-exporter:
    image: {{ docker_host_plex_exporter_image }}
    restart: unless-stopped
    # Configuration is env-var ONLY (collector.rb `initialize`): there is no
    # config file and no CLI flag, so this service has no `command:` — one
    # region fewer than pve-exporter, and a command here would REPLACE the
    # image's CMD rather than configure anything.
    #
    # PLEX_ADDR is not optional-with-a-sane-default: unset it defaults to
    # http://localhost:32400, i.e. the exporter probes its OWN container and
    # every scrape answers 200 with plex_up 0 while the target still reads UP.
    # PLEX_TOKEN is read from the sibling .env (rendered from vault_plex_token),
    # never a literal here; empty until Step 3b, and empty means /metrics 500s
    # (see env.j2). PLEX_RETRIES_COUNT stays 0 because the library sweep runs
    # synchronously inside the scrape and retries multiply the 10s PLEX_TIMEOUT
    # against the job's own scrape_timeout. METRICS_PREFIX is the image default
    # and is written out anyway: it is the first token of every series name the
    # Step-3b falsifiers and the Step-4 dashboards ask for, and nothing in the
    # container complains if it moves.
    environment:
      - PORT=9594
      - PLEX_ADDR={{ docker_host_plex_url }}
      - PLEX_TOKEN=${PLEX_TOKEN:-}
      - PLEX_TIMEOUT=10
      - PLEX_RETRIES_COUNT=0
      - PLEX_SSL_VERIFY=true
      - METRICS_PREFIX=plex
      - METRICS_MEDIA_COLLECTING_INTERVAL_SECONDS=1800

volumes:
  uptime-kuma-data:
  grafana-data:
  prometheus-data:
