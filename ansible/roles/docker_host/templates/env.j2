# {{ ansible_managed }}
# Compose env file (mode 0600). The Cloudflare DNS-01 token is sourced from the
# Ansible Vault (group_vars/vault.yml: vault_cloudflare_dns_api_token), never
# committed as a literal. Required by the le-dns-cf resolver after the Step-11
# migration; le-http (HTTP-01) ignores it.
CF_DNS_API_TOKEN={{ vault_cloudflare_dns_api_token | default('') }}
# Grafana admin password (Step 10), sourced from the Ansible Vault
# (group_vars/vault.yml: vault_grafana_admin_password), never a committed literal.
GF_SECURITY_ADMIN_PASSWORD={{ vault_grafana_admin_password | default('') }}
# Cloudflare Tunnel connector token (Step 4), sourced from the Ansible Vault
# (group_vars/vault.yml: vault_cloudflare_tunnel_token), never a committed literal.
# Consumed by the cloudflared service; empty until the operator creates the
# remotely-managed tunnel and stores its token in the vault.
TUNNEL_TOKEN={{ vault_cloudflare_tunnel_token | default('') }}
# Proxmox VE API token VALUE (plex-monitoring Step 2), sourced from the Ansible
# Vault (group_vars/all/vault.yml: vault_pve_api_token), never a committed
# literal. The user and the token NAME are non-secret and live in the role
# defaults. Empty until the operator mints the prometheus@pve PVEAuditor token
# (Step 2b) — `default('')` is what lets the repo-side wiring render and stay
# green before the value exists. Until then the container comes up healthy and
# its scrapes fail: measured against an auth-enforcing PVE stub, `/pve` answers
# HTTP 500 and Prometheus records `server returned HTTP status 500 INTERNAL
# SERVER ERROR` (logs/calibration-step02a-f3.log, B) — NOT the 401 this comment
# used to claim; PVE's 401 is what the exporter LOGS, not what it serves. Target
# DOWN with that lastError is the intended, expected pre-2b state.
PVE_TOKEN_VALUE={{ vault_pve_api_token | default('') }}
# Plex Media Server API token (plex-monitoring Step 3), sourced from the Ansible
# Vault (group_vars/all/vault.yml: vault_plex_token), never a committed literal.
# The Plex ADDRESS is not a secret and is already the docker_host_plex_url role
# default. Empty until the operator reads the token out of Plex (Step 3b) —
# `default('')` is what lets the repo-side wiring render and stay green before
# the value exists. Until then the container comes up and its scrapes FAIL HARD,
# which is different from the PVE row above: the exporter's unauthenticated
# /identity probe still answers, but every collector then reads a token-gated
# response, and what the collector rescues is HTTP::Error — a CONNECTION-level
# failure — and nothing else. A rejected token escapes it by at least two
# independent paths: JSON.parse of a non-JSON body raises JSON::ParserError
# (row B), and a JSON error body instead raises NoMethodError on the missing
# Directory in collect_media_metrics (row C). Either way /metrics answers HTTP
# 500 with ZERO series — plex_up included, since it never reaches the wire —
# rather than UP with plex_up 0 (logs/calibration-step03a-token.log, B and C).
# Read the rescue narrowly wherever it is cited: a TLS handshake failure is not
# an HTTP::Error either, so an https:// PLEX_ADDR whose cert does not verify
# 500s the same way instead of degrading (logs/review-step03a-case.log, M3).
# Inert while docker_host_plex_url is http://, which it is.
PLEX_TOKEN={{ vault_plex_token | default('') }}
