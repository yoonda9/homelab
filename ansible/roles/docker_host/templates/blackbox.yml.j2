# blackbox-exporter modules — plex-blip-manual-triage, design §4.6's probes.
# Managed by ansible (roles/docker_host/templates/blackbox.yml.j2). Do not edit
# on the host: the render is the source and a hand edit is lost at `just play`.
#
# THIS FILE CARRIES A LIVE PLEX API TOKEN. `plex_sessions`, at the bottom, sends
# `X-Plex-Token` from vault. That is why the render is 0640 root:root and not the
# 0644 the prometheus render uses: 0644 would publish the token to every user on
# the docker host. The mode was chosen at 5a in advance of the line existing —
# see tasks/main.yml — and readability is not what it buys, because this image
# declares no `USER` and the process is uid 0.
#
# THE SENTENCE ABOVE IS ARMED, because a file's header is exactly where a fact
# rots: `header_prose_current`, in
# `test_blackbox_sessions_probe_carries_the_vault_token`, scores THIS comment
# block against the PARSED document and reds in both directions — a
# credential-bearing module this header does not name, and this header naming a
# credential the document no longer has. It exists because Step 5b landed the
# token under a header that still described the file as carrying "the TWO THAT
# NEED NO CREDENTIAL" and `/status/sessions` as a future row.
#
# AND THERE IS DELIBERATELY NO INVENTORY HERE. Which modules exist is the
# document below, held against `BLACKBOX_MODULES` in
# scripts/test_traefik_config_shape.py. A count or a list in this comment would
# be a third spelling with nothing relating it to the other two — the same
# defect one paragraph up, and the reason a `5c` reader must take its
# `params.module` values from the tuple rather than from prose.
#
# A MODULE IS A HOW, NOT A WHAT. The URL is the scrape job's `__param_target`
# (prometheus.yml.j2, row 5c); what lives here is the probe's method, what counts
# as success, and which IP family to use.
#
# THE MODULE NAMES ARE A JOIN NOTHING AT RUNTIME CHECKS. A scrape job whose
# `module=` parameter names a module this file does not define gets HTTP 400 from
# /probe: the target reads DOWN, no `probe_*` series exist, and neither config is
# invalid. scripts/test_traefik_config_shape.py holds both ends against one
# tuple (`BLACKBOX_MODULES`) so a rename here cannot land without 5c's jobs.
#
# EVERY FIELD BELOW IS ENUMERATED IN THAT SAME FILE, WITH THE VALUE SHAPE IT
# MUST HAVE, and a field it has not learned REDS THE GATE —
# `BLACKBOX_{TOP,MODULE,HTTP,TLS}_FIELDS`. That is not pedantry: this exporter
# unmarshals STRICTLY, so `valid_status_code` (one character) is `Error loading
# config` + exit 1, and so is `timeout: 5` for the `timeout: 5s` below (one
# DELETED character) — and `restart: unless-stopped` turns either into the crash
# loop this role served for two weeks. The allow-list is this document's
# vocabulary rather than a copy of blackbox's schema, so adding a LEGAL field —
# a `min_version:` under `tls_config`, say — is a one-line edit to that map in
# the same commit. That is what the `headers:` below cost when it landed, and it
# is the price the next field pays too. Fail-closed, and deliberate.
modules:
  # /identity direct to the Plex container. Unauthenticated — it is Plex's own
  # healthcheck endpoint — and it does no database work, which is exactly why
  # design §4.6 polls it at 15 s and why it is NOT sufficient on its own: on
  # 2026-08-07 it answered HTTP 200 through the whole five-minute outage.
  plex_identity_direct:
    prober: http
    # Below the 15 s scrape interval 5c sets, so a hung probe is reported as a
    # failure rather than colliding with the next scrape. blackbox additionally
    # clamps to Prometheus's own timeout header minus --timeout-offset (0.5 s),
    # so this is a ceiling and not a floor.
    timeout: 5s
    http:
      method: GET
      # 200 only. blackbox's default accepts any 2xx, and Plex answering 204 on
      # /identity would be a state worth seeing rather than one to smooth over.
      valid_status_codes: [200]
      # ip4 with fallback OFF, deliberately. The default tries IPv6 first and
      # falls back, which turns a broken AAAA into added probe LATENCY rather
      # than a failure — and this probe exists to MEASURE latency, so a
      # resolution artefact would land in the series as a Plex stall.
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
      # A redirect is not a healthy /identity. Following one would let a captive
      # portal or a misrouted proxy answer 200 for a Plex that is down.
      #
      # `follow_redirects: false` and NOT the `no_follow_redirects: true` that
      # every blackbox example on the internet still shows: the pinned binary
      # accepts that spelling and WARNS on it at config load — "deprecated and
      # will be removed in the next release" — so the older spelling is a config
      # this image's successor rejects outright. Measured on v0.28.0 itself
      # (logs/builder-5a-live-A-C.log), not read off a changelog.
      follow_redirects: false
      # NO `fail_if_not_ssl` HERE, AND ITS ABSENCE IS PINNED. This probe's target
      # is plain HTTP on the compose network, so the field that is correct one
      # module down would make this one report `probe_success 0` for ever — a
      # permanent "the origin is down" that no certificate, restart or Plex fix
      # can clear. Measured on v0.28.0 against a plain-HTTP target: 1 as shipped,
      # 0 with the field added (logs/builder-5a-r2-tls-differential.log, H3).

  # /identity through Traefik: same endpoint, the whole public path. The pair is
  # the diagnosis — identity fast + proxied slow is a proxy/TLS fault, both slow
  # is the host or the database (design §4.6's differential table).
  plex_identity_proxied:
    prober: http
    timeout: 5s
    http:
      method: GET
      valid_status_codes: [200]
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
      follow_redirects: false
      # WHAT THIS FIELD BUYS IS THE PLAIN-HTTP REFUSAL, AND ONLY THAT. Traefik
      # carries a per-router http->https upgrade, so without it a probe that
      # silently accepted a plain-HTTP answer would report the redirect target's
      # health and call the TLS path green. Measured on v0.28.0 against a
      # plain-HTTP target: 0 as shipped, 1 with the field deleted
      # (logs/builder-5a-r2-tls-differential.log, G1/G2).
      #
      # IT DOES NOT PROTECT THE CERTIFICATE, and this comment used to say it did.
      # Against a leaf expired on 2026-06-01 the module reports 0 with the field
      # AND 0 without it (E1/E2) — that whole claim belongs to the field below.
      fail_if_not_ssl: true
      tls_config:
        # THIS IS THE RENEWAL CHECK, measured rather than assumed: with
        # `insecure_skip_verify: true` the same expired leaf reads
        # `probe_success 1` (E3), while all three spellings read 1 against a
        # valid cert (F1-F3). The wildcard is a real Let's Encrypt production
        # certificate (acme_resolver le-dns-cf), so leaving verification ON is a
        # live check of the thing most likely to break silently.
        #
        # SPELLED EXPLICITLY THOUGH `false` IS ALSO THE DEFAULT: the guard scores
        # this key's presence, so the sentence above has a line to red on and
        # deleting the block is caught exactly like flipping it.
        insecure_skip_verify: false

  # /status/sessions — plex-blip-manual-triage Step 5b, and THE PROBE THE
  # DIFFERENTIAL IS ACTUALLY MADE OF. `/identity` above answered HTTP 200 on
  # every poll through the whole five-minute outage of 2026-08-07 with a worst
  # case of 1,761 ms, while this endpoint reached 101,394 ms in the same window
  # (research/live-blip-2026-08-07-case-study.md) — an ~900x signal, because this
  # one touches session state and therefore the database whose lock is the open
  # suspect. `/identity` fast + this slow is the A2 database/lock signature;
  # both slow is host or thread-pool saturation (design §4.6's table).
  plex_sessions:
    prober: http
    # 30s, and it is NOT the 5s the two probes above use. Two constraints and
    # this value is between them: it must stay below the 60 s scrape interval
    # design §4.6 gives this probe (5c), so a hung probe is reported as a failure
    # rather than colliding with the next scrape; and it must sit WELL ABOVE the
    # 5 s that §4.6 alerts on (`probe_duration_seconds > 5`), because a timeout
    # AT the alert threshold clips the measurement exactly where it becomes
    # interesting — a 20 s stall would be recorded as a 5 s failure and the
    # "how slow" that separates a blip from an outage would be gone.
    #
    # A CEILING, NOT A FLOOR, exactly as the note on the direct module says:
    # blackbox clamps to Prometheus's own timeout header minus --timeout-offset
    # (0.5 s), so 5c's `scrape_timeout` is what will actually bind. This value is
    # what this module permits, not what it will take.
    timeout: 30s
    http:
      method: GET
      # 200 only, and here that is the AUTH check as much as the health check:
      # Plex answers /status/sessions with 401 when the token is missing or
      # rejected, and blackbox reports an auth rejection as HTTP 200 on /probe
      # with `probe_success 0`. So a broken token shows up in the SERIES and
      # never in the target's own up/down — see the guard clause for why every
      # pin on this module is at metric level.
      valid_status_codes: [200]
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
      follow_redirects: false
      # NO `fail_if_not_ssl` HERE EITHER, for the direct module's reason: this
      # probe's target is plain HTTP to the Plex container on the compose
      # network, so the field that is correct on the proxied module one block up
      # would make this one report `probe_success 0` for ever. Its absence is
      # pinned by the Step-5b clause, which reads it as `is not True` rather than
      # as "the key is absent" — see task-1786184652-0a6a.
      headers:
        # THE SECRET LINE. The vault reference and never a literal: the single
        # existing `vault_plex_token` spelling, the same one env.j2:46 uses, with
        # the `| default('')` filter that lets this render and stay green before
        # the operator has stored a value (env.j2:27-45 says so at length about
        # this exact variable).
        #
        # QUOTED, AND NOT FOR THE REASON THIS COMMENT USED TO GIVE. It said a
        # bare reference renders `X-Plex-Token:` with a null value and therefore
        # SENDS NO HEADER AT ALL, while quoted sends an empty one, and that the
        # difference is readable in a 401. The renders do differ; the REQUESTS
        # DO NOT. Driven through prom/blackbox-exporter:v0.28.0 against a
        # recording origin (logs/builder-5b-r2-wire.log): both spellings put
        # `X-Plex-Token` on the wire with an empty value, because go-yaml gives a
        # null map value the zero string and Go writes the header either way.
        # Three positive controls in the same transcript record a header with a
        # value, a header with an empty value, and no header at all, so the
        # recorder can see every state the claim was about — there is no 401
        # anyone could read differently.
        #
        # SO WHY QUOTE AT ALL, and this is a COUNT rather than a principle,
        # because the principle this comment used to give here — that a token
        # whose first character is YAML-significant "cannot break the document"
        # — is measurably false. 18 YAML-significant first characters x three
        # spellings, through real ansible-core into this image's own
        # `--config.check`, with the value read BACK OUT by a parser
        # (logs/builder-5b-r3-red.log leg B, logs/builder-5b-r3-quotestyle.log).
        # INTACT out of 18: double-quoted 16, single-quoted 17, BARE 4.
        #
        # BARE IS THE ONE TO AVOID and that is what `token_render_is_quoted` in
        # scripts/test_traefik_config_shape.py now holds — the guard could not
        # tell it from this line until it did, and the bare template was 47/47
        # GREEN. Bare REFUSES the config on eleven of the eighteen, which under
        # `restart: unless-stopped` is the crash loop this role served for two
        # weeks, and on three more (`&`, `#`, `!`) it loads at rc=0 carrying
        # something that is not the token.
        #
        # QUOTING IS STILL NOT A UNIVERSAL DEFENCE, AND THIS SPELLING IS NOT THE
        # BEST ONE. Double quotes lose twice. A `"` reproduces INSIDE them —
        # `X-Plex-Token: ""TOKEN"` — rc=1 `did not find expected key`, the
        # document broken by the quoting meant to prevent it. A `\` is the silent
        # loss: a YAML double-quoted scalar processes escapes, so `\P` is U+2029
        # and the config loads at rc=0 carrying a token that is NOT the
        # operator's — a probe reporting `probe_success 0` for ever with no
        # config error anywhere to read. SINGLE quotes beat that (17/18, and
        # their one loss is a loud rc=1), and this file does not use them for a
        # reason outside itself: `_neutralise_refs` substitutes a SINGLE-quoted
        # placeholder, so a single-quoted value makes the gate's own parse of
        # this template a `ParserError` (logs/builder-5b-r3-neutralise.log).
        # Filed as task-1786195905-16ec, not fixed here: the real fix is a
        # JSON-escaping filter, and a SECOND filter is refused on this file by
        # `test_templates_render_line_for_line`.
        #
        # THIS IS WHY THIS FILE IS 0640 AND NOT THE 0644 THE PROMETHEUS RENDER
        # USES. 0644 would publish a live Plex API token to every user on the
        # docker host — see tasks/main.yml, which chose this mode at 5a in
        # advance of this line existing.
        X-Plex-Token: "{{ vault_plex_token | default('') }}"
