# {{ ansible_managed }}
# Prometheus scrape config (Step 10). Targets are reached over the internal
# compose network by service name; node-exporter and cadvisor are unrouted
# scrape-only containers. Traefik exposes Prometheus metrics on :8082 (metrics
# entrypoint, see traefik.yml.j2).
global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Alert rules (plex-blip-manual-triage Step 7a), design §5.3. Before this key
# existed Prometheus evaluated NOTHING — `rule_files` was zero hits across
# ansible/ — so detection depended entirely on a human noticing a paused stream.
#
# A LITERAL PATH AND NOT A GLOB, AND THE CHOICE IS MEASURED
# (logs/builder-7a-literal-vs-glob.log, pinned prom/prometheus:v3.12.0, each
# direction with its own positive control):
#
#   rule_files: ["/etc/prometheus/rules/*.yml"] over an EMPTY directory is
#   `promtool check config` rc=0 — "... is valid prometheus config file syntax",
#   with the "SUCCESS: N rule files found" line simply ABSENT — while the same
#   glob with the file present is rc=0 WITH that line. A render that failed to
#   land is invisible under the glob. The literal below, pointed at a file that
#   does not exist, is rc=1 "... does not point to an existing file".
#
# Silent-healthy vs loud on one character; this takes the loud one. What it does
# NOT buy is a louder RUNTIME: a literal naming a missing file starts
# `running restarts=0`, logs `Completed loading of configuration file` and serves
# `{"groups":[]}` from /api/v1/rules — byte-for-byte the glob leg
# (logs/builder-7a-handler-question.log rows D5b/D6). The rc=1 only helps once
# something runs the validator before the restart handler fires, which is Step 7c.
#
# THE PATH IS NOT A SECOND LITERAL. It is the container side of the rules bind
# mount in compose.yml.j2, whose host side is the render task's own `dest` in
# tasks/main.yml — one relation walked end to end by RELOAD_CONTRACT's `named_in`
# hop in scripts/test_traefik_config_shape.py, which reads THIS list rather than
# comparing two strings that agree until one moves.
rule_files:
  - /etc/prometheus/rules/plex-blip-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node-exporter
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: cadvisor
    static_configs:
      - targets:
          - cadvisor:8080

  - job_name: traefik
    static_configs:
      - targets:
          - traefik:8082

  # Proxmox VE (plex-monitoring Step 2). MULTI-TARGET exporter, and the shape
  # below is the whole point: the TARGET is the PVE API host, the exporter is
  # only the address the request is sent to. metrics_path MUST be /pve — the
  # exporter's default /metrics path answers 200 with its OWN scrape/process
  # metrics, so a job pointed straight at pve-exporter:9221 reads UP in
  # Status -> Targets and produces ZERO pve_* series.
  # The params are written out for legibility only: cluster and node ALREADY
  # default to '1' in the exporter (on_pve(module='default', target='localhost',
  # cluster='1', node='1')), measured against the shipped 3.9.0 image. They are
  # NOT what makes pve_up{id="lxc/110"} exist — metrics_path and the
  # __param_target relabel below are.
  - job_name: pve-exporter
    metrics_path: /pve
    params:
      cluster: ['1']
      node: ['1']
    static_configs:
      - targets:
          - {{ docker_host_pve_api_host }}
    relabel_configs:
      # The configured target becomes the ?target= query parameter …
      - source_labels: [__address__]
        target_label: __param_target
      # … and is kept as the instance label, so series are attributed to the PVE
      # host rather than to the exporter container.
      - source_labels: [__param_target]
        target_label: instance
      # … while the request itself is dialed at the exporter.
      - target_label: __address__
        replacement: pve-exporter:9221

  # Plex Media Server (plex-monitoring Step 3). The SHAPE IS THE OPPOSITE of the
  # job above and that is deliberate: this exporter is NOT multi-target. It
  # serves its metrics on the plain default path (config.ru mounts
  # Prometheus::Middleware::Exporter; the collector runs only when PATH_INFO is
  # exactly "/metrics"), so a metrics_path here is a 404 and the target reads
  # DOWN, params are ignored, and there is no __param_target to relabel. The
  # target IS the exporter.
  #
  # The interval/timeout pair is job-local and both halves are required. The
  # exporter's collect_media_metrics runs SYNCHRONOUSLY inside the scrape and
  # issues one /library/sections/<key>/all per section (plus a second per `show`
  # section) once every METRICS_MEDIA_COLLECTING_INTERVAL_SECONDS (1800s), while
  # PLEX_TIMEOUT alone is 10s per request — so on the global 15s interval and
  # Prometheus' default 10s timeout, one scrape every thirtieth minute is the one
  # that times out. Prometheus REFUSES a config whose scrape_timeout exceeds its
  # scrape_interval, so raising the timeout without raising the interval loads
  # nothing at all; the two move together.
  - job_name: plex-exporter
    scrape_interval: 60s
    scrape_timeout: 50s
    static_configs:
      - targets:
          - plex-exporter:9594

  # CT 110's node-exporter (plex-blip Step 4d). The ONLY job in this file whose
  # target is not on the compose network — CT 110 is a separate LXC, so this
  # scrape crosses the LAN — and the only one whose two ends live in two
  # different Ansible roles. It collects the host telemetry the blip
  # investigation had no timeline for (load, D-state, PSI) AND, through
  # node-exporter's textfile collector, the watchdog's own `plex_*` series.
  #
  # THE NAME IS NOT `node-exporter`: that job is fifteen lines up and is the
  # DOCKER HOST's exporter on the compose network. Both emit `node_*` families;
  # they are told apart by `job` and by `instance`, which is why neither needs a
  # relabel and why this one cannot borrow the name.
  #
  # THE TARGET IS THE INVENTORY'S ADDRESS, NOT A SECOND COPY OF IT.
  # `docker_host_plex_url` in this role's defaults already spells CT 110's IP
  # once, for Traefik's public Plex router; a second spelling is two literals
  # that agree until one moves. `hostvars['plex']` is a BARE reference on
  # purpose: scripts/test_traefik_config_shape.py reads this template
  # LINE-structurally, so its `_LINE_BOUNDED_EXPR` refuses the rename-robust
  # `hostvars[groups['plex'] | first]` form (measured against the compiled
  # regex). The host name is therefore a literal that came from tofu's
  # `plex_name` output via gen_inventory.py, and the guard discharges it by
  # asserting inventory/hosts.yml really carries that host under that group.
  #
  # THE PORT IS 9100 HERE AND `plex_node_exporter_listen_address` THERE. That
  # default is a `plex` role variable and site.yml runs `docker_host` and `plex`
  # as separate plays, so this template CANNOT render it — the relation lives in
  # the guard, which reads the port half out of the role and requires this
  # literal to equal it. (Only the port half: `0.0.0.0` is a bind wildcard, not
  # a host anything dials.)
  #
  # NO `metrics_path`, and that is the pve-exporter comment above read in
  # reverse: node-exporter serves its metrics on the plain default path, so a
  # path copied off that job is a 404 — the target reads DOWN and the series
  # exist nowhere. Nothing here is multi-target either; the target IS the
  # exporter.
  #
  # The 15s interval is job-local rather than inherited so that this job's
  # cadence is a property of this job: it pairs with the watchdog's own
  # `textfile_refresh_sec` (15.0 s, design §4.5), because a textfile collector
  # re-serves whatever is on disk and the slower of the two decides the graph's
  # resolution. The guard pins that pair; a change to the global interval must
  # not coarsen it silently.
  #
  # The target is QUOTED and its neighbours are not, because it is the only one
  # that CONCATENATES an expression with a literal `:9100` suffix. Measured
  # unquoted, that shape makes this file fail YAML parsing as a ParserError
  # HERE, where at a0915e9 it failed as a ConstructorError on the pve target at
  # :49. Nothing parses this template as YAML — Jinja renders it first — but
  # moving the file's first failure onto this line for nothing is a property
  # worth not spending. The render is a plain `"192.168.1.110:9100"` either way.
  - job_name: plex-node-exporter
    scrape_interval: 15s
    static_configs:
      - targets:
          - "{{ hostvars['plex'].ansible_host }}:9100"

  # Synthetic HTTP probes of Plex (plex-blip-manual-triage Step 5c), design §4.6.
  # THE MULTI-TARGET SHAPE AGAIN, and it is the pve-exporter job read once more
  # rather than a new idea: the TARGET is the URL to probe, the exporter is only
  # the address the request is sent to. Three jobs and not one because the
  # DIFFERENTIAL is the diagnosis — /identity fast + /status/sessions slow is the
  # database/lock signature, both slow is host or thread-pool saturation, and
  # direct fast + proxied slow is Traefik/TLS/the tunnel. One job cannot say
  # which; and on 2026-08-07 /identity answered HTTP 200 through the entire
  # five-minute outage while /status/sessions reached 101,394 ms, so a
  # probe_success check on the cheap endpoint alone would have stayed green
  # throughout (research/live-blip-2026-08-07-case-study.md).
  #
  # THE JOB NAMES ARE A CROSS-STEP RELATION. Design §5.3 writes Step 7's alerts
  # as probe_duration_seconds{job="blackbox-plex-identity"},
  # {job="blackbox-plex-sessions"} and probe_success{job=~"blackbox-plex.*"}. A
  # rename here leaves those rules matching nothing and firing never — an alert
  # with no series to match looks exactly like an alert with nothing to say.
  # Step 7 does not exist yet, so the guard pins the shared blackbox-plex prefix
  # and says so; the exact-match half arrives with the rules.
  #
  # metrics_path IS /probe ON ALL THREE, which is the pve-exporter comment above
  # for a third time: blackbox also serves /metrics, its OWN process metrics, so
  # a job left on Prometheus' default path reads UP in Status -> Targets and
  # produces ZERO probe_* series. And `module=` is a JOIN NOTHING CHECKS — a
  # module blackbox.yml does not define answers HTTP 400 from /probe, the target
  # reads DOWN, and neither config is invalid. Both ends are held against one
  # tuple in scripts/test_traefik_config_shape.py.
  #
  # NO URL IS SPELLED TWICE. docker_host_plex_url is this role's existing default
  # for CT 110 (Traefik's public Plex router already uses it) and the public
  # hostname is dynamic.yml.j2's own router rule; re-typing either is two
  # literals that agree until one moves. The guard reads the proxied host OUT of
  # that rule, so the probe follows the route it is measuring.
  #
  # THE FIRST TWO TARGETS ARE QUOTED BECAUSE OF THE GUARD, NOT BECAUSE OF THE
  # CONCATENATION, and the comment on plex-node-exporter above generalises its
  # own case wrongly. The guard parses this template with every reference
  # replaced by a single-quoted placeholder, so what breaks the document is a
  # value that BEGINS with a reference: '<REF>'/identity is a ParserError, while
  # https://plex.'<REF>'/identity parses clean. Measured at Step 5c against the
  # shipped reader (logs/builder-5c-target-spellings.log), with the pve target as
  # the control. The proxied target is quoted for symmetry with its two
  # neighbours and would parse bare.
  #
  # THE INTERVAL/TIMEOUT PAIR IS TWO DECISIONS AND THE SECOND ONE IS NOT ABOUT
  # THIS FILE. Prometheus refuses a config whose scrape_timeout EXCEEDS its
  # scrape_interval (equality loads — measured, 61s vs 60s is rc=1 and 60s vs 60s
  # is rc=0 on prom/prometheus:v3.12.0). Separately, blackbox clamps every probe
  # to Prometheus' own scrape-timeout header MINUS --timeout-offset (0.5s), so
  # each module's `timeout:` in blackbox.yml.j2 is a ceiling and the value below
  # is what actually binds. That is why plex-sessions carries an explicit 35s: on
  # Prometheus' 10s default its module's 30s — chosen to sit well above the 5s
  # that design §4.6 alerts on — would be unreachable, and every stall would be
  # recorded as a 9.5s failure with no config invalid anywhere.
  - job_name: blackbox-plex-identity
    metrics_path: /probe
    params:
      module: [plex_identity_direct]
    scrape_interval: 15s
    static_configs:
      - targets:
          - "{{ docker_host_plex_url }}/identity"
    relabel_configs:
      # The probed URL becomes the ?target= query parameter …
      - source_labels: [__address__]
        target_label: __param_target
      # … and is kept as the instance label. WITHOUT THIS HOP THE PROBES STILL
      # RUN: every series would be attributed to blackbox-exporter:9115, all
      # three jobs would land on one instance, and the differential above could
      # not be read off a graph at all.
      - source_labels: [__param_target]
        target_label: instance
      # … while the request itself is dialed at the exporter.
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-plex-sessions
    metrics_path: /probe
    params:
      module: [plex_sessions]
    scrape_interval: 60s
    scrape_timeout: 35s
    static_configs:
      - targets:
          - "{{ docker_host_plex_url }}/status/sessions"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-plex-proxied
    metrics_path: /probe
    params:
      module: [plex_identity_proxied]
    scrape_interval: 15s
    static_configs:
      - targets:
          - "https://plex.{{ domain }}/identity"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
